---
// Page shell: head (SEO, fonts, JSON-LD), skip link, initial sticky-pause tops (design.md §4, §8, §9).
// Latin subsets only: the copy is English, and other subsets were inlined as base64 into the CSS (QA F1).
import '@fontsource/schibsted-grotesk/latin-400.css';
import '@fontsource/schibsted-grotesk/latin-500.css';
import '@fontsource/schibsted-grotesk/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import sans400 from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url';
import sans500 from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-500-normal.woff2?url';
import sans600 from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-600-normal.woff2?url';
import mono400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import mono500 from '@fontsource/geist-mono/files/geist-mono-latin-500-normal.woff2?url';

// Preload every used latin face: a late swap reflows text above deep-linked sections (CLS).
const fonts = [sans400, sans500, sans600, mono400, mono500];

import { analytics } from '../data/site';
import { offers } from '../data/offers';
import { talk } from '../data/community';

interface Props {
  title?: string;
  description?: string;
}

const {
  // Buyers search for a service, not for a job title: "data consultant Poland",
  // "freelance data engineer", "AWS cost optimization consultant", "AWS Claude training".
  title = 'Adam Zuzo - Data & AI Consultant, Poznan | Apps, Consulting, Training',
  // Under 155 chars so Google shows it whole, and "consultant" not "engineer" - every other
  // surface sells a service now, and this line is the one a buyer reads before clicking.
  description =
    'Freelance data & AI consultant in Poland. Apps and automations for small businesses, data platform and AWS cost consulting, training on AWS and Claude.',
} = Astro.props;

const site = Astro.site?.href ?? 'https://azuzo99.github.io/';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Adam Zuzo',
  jobTitle: 'Data & AI Engineer',
  url: site,
  email: 'mailto:zuzoadam@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Poznan', addressCountry: 'PL' },
  sameAs: [
    'https://www.linkedin.com/in/adam-zuzo/',
    'https://www.instagram.com/zuzo_adam/',
    'https://github.com/azuzo99',
  ],
};

// The page declares a *service* as well as a person: a Person entity alone reads as a
// candidate profile to both search engines and answer engines.
const service = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Adam Zuzo - Data & AI Consulting',
  url: site,
  provider: { '@type': 'Person', name: 'Adam Zuzo', url: site },
  areaServed: ['PL', 'EU'],
  knowsAbout: [
    'Data engineering',
    'AWS',
    'Snowflake',
    'dbt',
    'Apache Iceberg',
    'Apache Airflow',
    'Cloud cost optimization',
    'AI agents',
    'Model Context Protocol',
    'Retrieval-augmented generation',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Ways to work with me',
    itemListElement: [
      'AI apps and automations for small businesses',
      'Data platform and cloud cost consulting',
      'AWS and Claude training and mentoring',
    ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
  },
};

// The three questions are rendered verbatim as question-and-answer pairs inside the offer
// cards, so the markup mirrors visible text. Do not add entries that are not rendered as Q&A.
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: offers.map((o) => ({
    '@type': 'Question',
    name: o.objection.q,
    acceptedAnswer: { '@type': 'Answer', text: o.objection.a },
  })),
};

// uploadDate and duration read from the real video (yt-dlp: 20260708, 3068 s); `name` is the
// actual YouTube title, which is Polish - the English line stays in `description`.
const video = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: '[#659] DataOps i koszty: operacyjne wyzwania danych - Adam Zuzo',
  description: talk.body,
  thumbnailUrl: new URL(talk.thumb.src, site).href,
  embedUrl: 'https://www.youtube-nocookie.com/embed/SE4vJdIIbGM',
  uploadDate: '2026-07-08',
  duration: 'PT51M8S',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Adam Zuzo" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FBF6EE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/ld+json" set:html={JSON.stringify(service)} />
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
    <script type="application/ld+json" set:html={JSON.stringify(video)} />
    {analytics.umamiWebsiteId && (
      <script defer src="https://cloud.umami.is/script.js" data-website-id={analytics.umamiWebsiteId}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div style="min-height: 100vh; position: relative;">
      <slot />
    </div>
    <script is:inline>
      // Initial sticky-pause `top` before first paint (v4:L873-888 formula). shell.ts keeps it updated.
      (function () {
        var vh = window.innerHeight, avail = vh - 96;
        document.querySelectorAll('[data-pause]').forEach(function (c) {
          var pb = parseFloat(getComputedStyle(c).paddingBottom) || 0;
          var content = c.offsetHeight - pb;
          c.style.top = Math.round(content <= avail ? 90 + (avail - content) / 2 : vh - content - 16) + 'px';
        });
        // Deep link: jump without the smooth animation so /#id lands at scroll-margin-top (96px) immediately.
        if (location.hash.length > 1) {
          var t = document.getElementById(decodeURIComponent(location.hash.slice(1)));
          if (t) { var r = document.documentElement; r.style.scrollBehavior = 'auto'; t.scrollIntoView(); r.style.scrollBehavior = ''; }
        }
      })();
    </script>
  </body>
</html>
