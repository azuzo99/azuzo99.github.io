---
// Component B: Offers (#services). v4:L174-253 (markup), L823-838, L900-911, L1047-1093 (logic).
// Slider variant (scrollMode) and accordion variant (otherwise) share the data; offers.ts drives state.
import { Image } from 'astro:assets';
import { offers, offersSection as S } from '../../data/offers';
---
<section id="services" data-chapter="01" aria-labelledby="services-h" data-screen-label="01 Services">
  <div class="sec">
    <div class="row">
      <div class="intro" data-reveal>
        <div class="intro-top">
          <span class="mono muted2">{S.num}</span>
          <h2 id="services-h">{S.headingLines[0]}<br />{S.headingLines[1]}</h2>
          <p class="lead">{S.lead}</p>
        </div>
        <span class="mono muted2 tap-hint">{S.tapHint}</span>
        <div class="tabs-wrap">
          <div role="tablist" aria-label={S.tablistLabel} class="tablist">
            {offers.map((o, i) => (
              <button role="tab" type="button" id={`offer-tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`offer-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-test="offer-tab" data-i={i}>
                <span class="tab-title"><span class="mono tab-num">{o.num}</span>{o.tabTitle}</span>
                <span class="tab-who">{o.cWho}</span>
                <span class="bar" data-test="offer-bar"></span>
              </button>
            ))}
          </div>
          <span class="mono muted2 scroll-hint">{S.scrollHint}</span>
        </div>
      </div>
      <div class="panel" data-reveal data-delay="100">
        <div class="track" data-test="offer-track">
          {offers.map((o, i) => (
            <article role="tabpanel" id={`offer-panel-${i}`} aria-labelledby={`offer-tab-${i}`} data-variant="slider" class="card slider">
              <div class="top">
                <span class="tag"><span class="mono for">FOR</span>{o.tag}</span>
                <span class="mono count">{o.num} / {S.total}</span>
              </div>
              <h3>{o.title}</h3>
              <p class="pitch">{o.pitch} <strong>{o.value}</strong></p>
              <div class="points">
                {o.points.map((p) => (
                  <div class="point">
                    <span class="ico"><span class="mono-fb mono" aria-hidden="true">{p.mono}</span>{p.icon && <Image src={p.icon} alt="" width={18} height={18} loading="lazy" />}</span>
                    <span>{p.t}</span>
                  </div>
                ))}
              </div>
              <p class="proof"><span class="mono">{S.proofLabel}</span>{o.proof}</p>
              <div class="reach">
                <span class="reach-label">{S.reachLabel}</span>
                <div class="chans">
                  {o.channels.map((c) => (
                    <a class:list={['ch', { primary: c.primary }]} href={c.href} target="_blank" rel="noreferrer"><span class="chi"><Image src={c.icon} alt="" width={14} height={14} loading="lazy" /></span>{c.label}</a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="acc">
          {offers.map((o, i) => (
            <article data-variant="accordion" class="card accordion" data-open="false" data-i={i}>
              <button type="button" class="toggle" aria-expanded="false" aria-controls={`offer-acc-${i}`}>
                <span class="mono num">{o.num}</span>
                <span class="toggle-text">
                  <span class="ctitle">{o.cTitle}</span>
                  <span class="cwho">{o.cWho}</span>
                </span>
                <span class="tg" aria-hidden="true">+</span>
              </button>
              <div id={`offer-acc-${i}`} class="acc-body" hidden>
                <p class="valuecap">{o.valueCap}</p>
                <div class="points">
                  {o.points.map((p) => (
                    <div class="point">
                      <span class="ico"><span class="mono-fb mono" aria-hidden="true">{p.mono}</span>{p.icon && <Image src={p.icon} alt="" width={18} height={18} loading="lazy" />}</span>
                      <span>{p.t}</span>
                    </div>
                  ))}
                </div>
                <div class="reach">
                  <div class="chans">
                    {o.channels.map((c) => (
                      <a class:list={['ch', { primary: c.primary }]} href={c.href} target="_blank" rel="noreferrer"><span class="chi"><Image src={c.icon} alt="" width={14} height={14} loading="lazy" /></span>{c.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #services { position: relative; }
  .sec { max-width: 1180px; margin: 0 auto; padding: clamp(16px,2vw,24px) var(--gutter) clamp(56px,7vw,96px); }
  .mono { font-family: var(--font-mono); font-size: 12px; }
  .muted2 { color: var(--muted-2); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; }
  .intro { flex: 1 1 320px; min-width: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: clamp(22px,3vw,28px); display: flex; flex-direction: column; justify-content: space-between; gap: clamp(22px,4vw,40px); }
  .intro-top { display: flex; flex-direction: column; gap: 14px; }
  h2 { margin: 0; font-weight: 500; font-size: clamp(38px,5.4vw,72px); line-height: .95; letter-spacing: -.045em; }
  .lead { margin: 0; font-size: 15px; line-height: 1.5; color: var(--muted); max-width: 32ch; }
  .tabs-wrap { display: none; flex-direction: column; gap: 10px; }
  .scroll-hint { padding-left: 4px; }
  .tablist { display: flex; flex-direction: column; gap: 6px; }
  .tablist button { position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 18px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); font: inherit; text-align: left; cursor: pointer; color: var(--muted); transition: background .35s ease, color .35s ease, border-color .35s ease; }
  .tablist button[aria-selected='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .tab-title { position: relative; display: flex; align-items: baseline; gap: 12px; font-size: 17px; font-weight: 500; }
  .tab-num { opacity: .7; }
  .tab-who { position: relative; font-size: 13px; font-weight: 500; padding: 5px 11px; border-radius: 999px; background: var(--card); color: var(--ink); white-space: nowrap; }
  .tablist button[aria-selected='true'] .tab-who { background: var(--green); }
  .bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 0%; background: var(--ink); }
  .tablist button[aria-selected='true'] .bar { background: var(--green); }

  .panel { flex: 1.7 1 520px; min-width: 0; background: transparent; color: var(--bg); border-radius: 16px; position: relative; overflow: visible; display: flex; flex-direction: column; gap: 10px; }
  .track { display: none; width: 100%; will-change: transform; }
  .acc { display: flex; flex-direction: column; gap: 12px; }

  .card { box-sizing: border-box; border-radius: 16px; display: flex; flex-direction: column; gap: clamp(12px,1.6vw,18px); transition: background .3s ease, color .3s ease; scroll-margin-top: 150px; }
  .accordion { padding: 14px 18px; background: var(--bg); color: var(--ink); border: 1px solid var(--border); }
  .accordion[data-open='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .slider { flex: 0 0 100%; width: 100%; padding: clamp(20px,3.4vw,40px); background: var(--ink); color: var(--bg); border: 1px solid var(--ink); }
  .toggle { display: flex; align-items: center; gap: 14px; width: 100%; min-height: 56px; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .num { opacity: .7; flex: none; }
  .toggle-text { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .ctitle { font-size: 21px; font-weight: 500; letter-spacing: -.025em; line-height: 1.1; }
  .cwho { align-self: flex-start; font-size: 13px; font-weight: 500; padding: 4px 10px; border-radius: 999px; background: var(--green); color: var(--ink); }
  .tg { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--bg); font-size: 22px; line-height: 1; }
  .accordion[data-open='true'] .tg { background: var(--bg); color: var(--ink); }
  .acc-body { display: flex; flex-direction: column; gap: clamp(12px,1.6vw,18px); }
  .acc-body[hidden] { display: none; }
  .valuecap { margin: 0; font-size: 17px; line-height: 1.4; font-weight: 600; color: var(--bg); text-wrap: pretty; }

  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .tag { display: inline-flex; align-items: center; gap: 10px; font-size: clamp(15px,1.4vw,18px); font-weight: 500; padding: 8px 18px 8px 8px; border-radius: 999px; background: var(--green); color: var(--ink); }
  .for { letter-spacing: .06em; padding: 4px 9px; border-radius: 999px; background: var(--ink); color: var(--green); }
  .count { color: var(--muted-3); white-space: nowrap; }
  h3 { margin: 0; font-weight: 500; font-size: clamp(28px,4vw,54px); line-height: .98; letter-spacing: -.045em; text-wrap: balance; }
  .pitch { margin: 0; font-size: clamp(15px,1.4vw,16px); line-height: 1.5; color: var(--muted-dark); max-width: 52ch; text-wrap: pretty; }
  .pitch strong { color: var(--bg); font-weight: 600; }
  .points { display: flex; flex-direction: column; }
  .point { display: flex; align-items: center; gap: 12px; padding: clamp(9px,1.2vw,12px) 0; border-top: 1px solid var(--d-2e); font-size: clamp(14px,1.3vw,15px); line-height: 1.4; }
  .ico { position: relative; width: 32px; height: 32px; border-radius: 8px; background: var(--white); display: grid; place-items: center; flex: none; }
  .mono-fb { position: absolute; inset: 0; display: grid; place-items: center; font-size: 9px; color: var(--muted-2); }
  .ico img { position: relative; width: 18px; height: 18px; object-fit: contain; background: var(--white); }
  .proof { margin: 0; font-size: 13px; line-height: 1.5; color: var(--muted-dark); }
  .proof .mono { margin-right: 8px; color: var(--bg); }
  .reach { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--d-2e); display: flex; flex-direction: column; gap: 10px; }
  .reach-label { font-size: 12px; color: var(--muted-3); }
  .chans { display: flex; flex-wrap: wrap; gap: 8px; }
  .ch { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px 10px 12px; border-radius: 999px; background: transparent; color: var(--bg); border: 1px solid var(--d-3a); font-size: 14px; font-weight: 500; }
  .ch.primary { background: var(--bg); color: var(--ink); border-color: transparent; }
  .ch:hover { opacity: .85; color: var(--bg); }
  .ch.primary:hover { color: var(--ink); }
  .chi { width: 22px; height: 22px; border-radius: 6px; background: var(--white); display: grid; place-items: center; }
  .chi img { width: 14px; height: 14px; object-fit: contain; }

  @media (min-width: 900px) and (min-height: 720px) {
    #services { height: 240vh; }
    .sec { position: sticky; top: 84px; }
    .tap-hint, .acc { display: none; }
    .tabs-wrap { display: flex; }
    .panel { background: var(--ink); overflow: hidden; }
    .track { display: flex; flex-direction: row; height: 100%; gap: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tablist button, .card { transition: none; }
  }
</style>

<script>
  import '../../scripts/offers';
</script>
