---
// Contact + footer (v4:L733-773, L913-918, L1198-1207; design.md §6.9; inv §3.10, §4 #19).
import { Image } from 'astro:assets';
import { contactSection, contacts, email, footer } from '../../data/contact';
---
<section id="contact" data-chapter="06" aria-labelledby="contact-h">
  <div class="sec" style="max-width: 1180px; margin: 0 auto; padding: 0 var(--gutter) 24px;">
    <div data-reveal class="card">
      <div class="top">
        <div class="lead">
          <span style="font-family: var(--font-mono); font-size: 12px; color: #77716A;">{contactSection.num}</span>
          <h2 id="contact-h" style="margin: 0; font-weight: 500; font-size: clamp(56px,8vw,120px); line-height: .9; letter-spacing: -.055em;">{contactSection.heading}</h2>
          <p data-only="notphone" class="body" style="font-size: 18px; line-height: 1.55; max-width: 44ch;">{contactSection.body}</p>
          <p data-only="phone" class="body" style="font-size: 17px; line-height: 1.5;">{contactSection.bodyShort}</p>
          <a class="cta" href={contactSection.cta.href} target="_blank" rel="noreferrer" data-umami-event="cta-book-contact">{contactSection.cta.label}</a>
          {contactSection.secondary.href && (
            <p class="second">
              <span class="second-l">{contactSection.secondary.label}</span>
              <a class="second-a" href={contactSection.secondary.href} target="_blank" rel="noreferrer" data-umami-event="form-open">{contactSection.secondary.text}</a>
              <span class="second-n">{contactSection.secondary.note}</span>
            </p>
          )}
        </div>
        <div class="cl">
          <div class="cl-links">
            {contacts.map((k) => (
              <a class="ck" href={k.href} target="_blank" rel="noreferrer">
                <span class="ck-l"><span class="ck-ic"><Image src={k.icon} alt="" width={40} height={40} loading="lazy" /></span><span class="ck-t"><span class="ck-n">{k.label}</span><span class="ck-s" data-only="notphone">{k.sub}</span></span></span><span data-only="notphone">{contactSection.rowArrow}</span>
              </a>
            ))}
          </div>
          <button type="button" class="copy" data-test="copy-email" data-address={email.address} data-reset={email.resetMs}>
            <span class="copy-l"><span class="copy-a">{email.address}</span><span class="copy-h" data-only="notphone" data-hint data-idle={email.hint} data-done={email.hintDone}>{email.hint}</span></span><span class="copy-act" data-action data-idle={email.action} data-done={email.actionDone}>{email.action}</span>
          </button>
          <span class="sr-only" role="status" aria-live="polite" data-test="copy-state"></span>
        </div>
      </div>
      <div class="foot">
        <span>{footer.copyright}</span>
        <span data-only="notphone">{footer.tagline}</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #contact .card { background: #111111; color: #FBF6EE; border-radius: 20px; padding: clamp(24px,5vw,64px); display: flex; flex-direction: column; gap: clamp(28px,5vw,64px); }
  #contact .top { display: flex; flex-wrap: wrap; gap: clamp(24px,4vw,40px) 56px; align-items: flex-end; justify-content: space-between; }
  #contact .lead { flex: 1.3 1 480px; min-width: 0; display: flex; flex-direction: column; gap: clamp(16px,2.4vw,24px); }
  #contact .body { margin: 0; color: #CFC8BC; }
  #contact .cta { align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; background: #FBF6EE; color: #111111; padding: 17px 28px; border-radius: 999px; font-weight: 500; font-size: 16px; }
  #contact .cta:hover { background: #E9E1D3; color: #111111; }
  /* Deliberately quiet: the call is the primary path, this one only catches the people who
     will never book one cold. */
  #contact .second { margin: -8px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 14px; color: #CFC8BC; }
  #contact .second-a { color: #FBF6EE; border-bottom: 1px solid #3A3A3A; }
  #contact .second-a:hover { color: #FBF6EE; border-bottom-color: #FBF6EE; }
  #contact .second-n { font-size: 13px; color: #77716A; }
  #contact .cl { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  #contact .cl-links { display: flex; flex-direction: column; gap: 8px; }
  #contact .ck { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; border-radius: 14px; background: #1C1C1C; border: 1px solid #2A2A2A; color: #FBF6EE; }
  #contact .ck:hover { background: #262626; color: #FBF6EE; }
  #contact .ck-l { display: flex; align-items: center; gap: 14px; }
  #contact .ck-ic { width: 36px; height: 36px; border-radius: 10px; background: #FBF6EE; display: grid; place-items: center; flex: none; }
  #contact .ck-ic img { width: 20px; height: 20px; }
  #contact .ck-t { display: flex; flex-direction: column; gap: 2px; }
  #contact .ck-n { font-size: 17px; font-weight: 500; }
  #contact .ck-s { font-size: 13px; color: #77716A; }
  #contact .copy { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; border-radius: 14px; background: #1C1C1C; border: 1px solid #2A2A2A; color: #FBF6EE; font: inherit; text-align: left; cursor: pointer; }
  #contact .copy:hover { background: #262626; }
  #contact .copy-l { display: flex; flex-direction: column; gap: 2px; }
  #contact .copy-a { font-size: 17px; font-weight: 500; }
  #contact .copy-h { font-size: 13px; color: #77716A; }
  #contact .copy-act { font-family: var(--font-mono); font-size: 12px; }
  #contact .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 22px; border-top: 1px solid #2A2A2A; font-size: 13px; color: #77716A; }
  @media (max-width: 599px) {
    #contact [data-only=notphone] { display: none; }
    /* Stack so the link gets its own 44px row - it is a real tap target on a phone. */
    #contact .second { flex-direction: column; gap: 0; }
    #contact .second-a { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; }
    #contact .cl { flex: 1 1 100%; }
    #contact .cl-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #contact .ck { flex-direction: column; justify-content: flex-start; gap: 8px; padding: 14px 6px; font-size: 13px; font-weight: 500; }
    #contact .ck-l { flex-direction: column; gap: 8px; }
    #contact .ck-ic { width: 34px; height: 34px; }
    #contact .ck-ic img { width: 18px; height: 18px; }
    #contact .ck-n { font-size: 13px; }
    #contact .copy { gap: 12px; min-height: 48px; padding: 12px 16px; font-size: 15px; font-weight: 500; }
    #contact .copy-a { font-size: 15px; }
  }
  @media (min-width: 600px) { #contact [data-only=phone] { display: none; } }
</style>

<script>
  import '../../scripts/tail';
</script>
