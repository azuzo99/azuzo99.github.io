---
// Stack (v4:L619-691; design.md §3, §6.7; inv §3.7). One DOM for tools; wide/compact heads are swapped by tail.ts.
import { Image } from 'astro:assets';
import { stackSection, exploring, stackGroups } from '../../data/stack';
---
<section id="stack" data-chapter="05" aria-labelledby="stack-h">
  <div class="sec" data-pause style="max-width: 1180px; margin: 0 auto; padding: 0 var(--gutter) var(--section-pb); display: flex; flex-direction: column; gap: 12px;">
    <div data-reveal style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 0 4px 20px;">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <span style="font-family: var(--font-mono); font-size: 12px; color: #5C5850;">{stackSection.num}</span>
        <h2 id="stack-h" style="margin: 0; font-weight: 500; font-size: clamp(48px,6vw,88px); line-height: .92; letter-spacing: -.05em;">{stackSection.heading}</h2>
      </div>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; justify-content: flex-end;">
        <span style="font-size: 13px; color: #5C5850; margin-right: 4px;">{stackSection.exploringLabel}</span>
        {exploring.map((x) => (
          <span style="display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; padding: 8px 14px; border-radius: 999px; background: #111111; color: #FBF6EE;"><span style="width: 6px; height: 6px; border-radius: 50%; background: #7FC7A0;"></span>{x}</span>
        ))}
      </div>
    </div>
    <div class="groups">
      {stackGroups.map((g) => (
        <div class="g" data-test="stack-group" data-reveal>
          <div class="g-wide" data-only="wide">
            <span class="g-label">{g.label}</span>
            <span class="g-count">{g.count}{stackSection.toolsSuffix}</span>
          </div>
          <button type="button" class="g-head" data-only="compact" aria-expanded="false" aria-controls={`stack-list-${g.key}`}>
            <span class="g-mid">
              <span class="g-title"><span class="g-label">{g.label}</span><span class="g-count">{g.count}{stackSection.toolsSuffix}</span></span>
              <span class="peek">
                {g.items.slice(0, 6).map((p) => (
                  <span class="peek-i"><span class="mono" aria-hidden="true">{p.mono}</span>{p.icon && <Image src={p.icon} alt={p.name} width={36} height={36} loading="lazy" />}</span>
                ))}
              </span>
            </span>
            <span class="sign" data-sign>+</span>
          </button>
          <div class="list" id={`stack-list-${g.key}`}>
            {g.items.map((t) => (
              <button type="button" class="tool" data-test="stack-tool" data-id={t.id} aria-pressed="false">
                <span class="t-row">
                  <span class="tile"><span class="mono" aria-hidden="true">{t.mono}</span>{t.icon && <Image src={t.icon} alt="" width={40} height={40} loading="lazy" />}</span>
                  <span class="t-txt"><span class="t-name">{t.name}</span><span class="t-sub">{t.sub}</span></span>
                  <span class="t-mark" data-only="compact" data-mark>+</span>
                </span>
                <span class="where" data-test="where-used"><span class="where-l">{stackSection.whereLabel}</span>{t.where}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
    <span class="hint" data-only="wide">{stackSection.hint}</span>
  </div>
</section>

<style is:global>
  #stack .groups { display: flex; flex-direction: column; gap: 10px; }
  #stack .g { background: #F1EADF; color: #111111; border: 1px solid #E4DACA; border-radius: 16px; padding: 16px 18px; display: flex; flex-direction: column; gap: 12px; transition: background .3s ease, color .3s ease; }
  #stack .g[data-open] { background: #111111; color: #FBF6EE; border-color: #111111; }
  #stack .g-wide { display: none; }
  #stack .g-head { display: flex; align-items: center; gap: 14px; width: 100%; min-height: 52px; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  #stack .g-mid { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  #stack .g-title { display: flex; align-items: baseline; gap: 10px; }
  #stack .g-label { font-size: 20px; font-weight: 500; letter-spacing: -.02em; }
  #stack .g-count { font-family: var(--font-mono); font-size: 12px; opacity: .65; }
  #stack .peek { display: flex; gap: 6px; flex-wrap: wrap; }
  #stack .peek-i { position: relative; width: 30px; height: 30px; border-radius: 8px; background: #FFFFFF; border: 1px solid #E4DACA; box-sizing: border-box; display: grid; place-items: center; }
  #stack .peek-i img { position: relative; width: 18px; height: 18px; object-fit: contain; background: #FFFFFF; }
  #stack .mono { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-mono); font-size: 10px; color: #4E4A44; }
  #stack .sign { flex: none; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: #111111; color: #FBF6EE; font-size: 20px; line-height: 1; }
  #stack .g[data-open] .sign { background: #FBF6EE; color: #111111; }
  #stack .list { display: none; flex-direction: column; }
  #stack .g[data-open] .list { display: flex; }
  #stack .tool { display: flex; flex-direction: column; gap: 6px; width: 100%; padding: 12px 0; border: 0; border-top: 1px solid #2E2E2E; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  #stack .t-row { display: flex; align-items: center; gap: 12px; width: 100%; }
  #stack .tile { position: relative; width: 34px; height: 34px; border-radius: 9px; background: #FFFFFF; display: grid; place-items: center; flex: none; }
  #stack .tile img { position: relative; width: 20px; height: 20px; object-fit: contain; background: #FFFFFF; }
  #stack .t-txt { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  #stack .t-name { font-size: 16px; font-weight: 500; }
  #stack .t-sub { font-size: 12px; color: #BDB6AA; }
  #stack .t-mark { font-family: var(--font-mono); font-size: 14px; color: #7FC7A0; flex: none; }
  #stack .where { display: none; padding-left: 46px; font-size: 14px; line-height: 1.45; color: #FBF6EE; }
  #stack .tool[data-open] .where { display: block; }
  #stack .where-l { display: block; font-family: var(--font-mono); font-size: 11px; color: #7FC7A0; margin-bottom: 3px; }
  #stack .hint { display: none; font-size: 13px; color: #5C5850; padding: 0 4px; }
  /* before tail.ts detaches the other band's markup */
  @media (max-width: 859px) { #stack [data-only=wide] { display: none; } }
  @media (min-width: 860px) {
    #stack [data-only=compact] { display: none; }
    #stack .groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-items: start; }
    #stack .g, #stack .g[data-open] { background: #F1EADF; color: #111111; border-color: #E4DACA; padding: 22px 22px 10px; gap: 10px; }
    #stack .g-wide { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding-bottom: 6px; }
    #stack .g-wide .g-label { font-size: 22px; }
    #stack .g-wide .g-count { opacity: 1; color: #5C5850; }
    #stack .list, #stack .g[data-open] .list { display: flex; }
    #stack .tool { gap: 8px; padding: 12px 10px; margin: 0 -10px; box-sizing: content-box; border-top-color: #E4DACA; border-radius: 10px; transition: background .25s ease, color .25s ease; }
    #stack .tile { width: 36px; height: 36px; border-radius: 10px; border: 1px solid #E4DACA; box-sizing: border-box; }
    #stack .t-sub { color: #5C5850; }
    #stack .where { padding-left: 48px; font-size: 13px; color: inherit; }
    #stack .tool[data-open] { background: #111111; color: #FBF6EE; }
    #stack .tool[data-open] .t-sub { color: #BDB6AA; }
    #stack .hint { display: block; }
  }
</style>

<script>
  import '../../scripts/tail';
  import '../../scripts/stack';
</script>
