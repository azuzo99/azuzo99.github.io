---
// #work (v4:L329-534). Phone (<600): body collapsed, "Show details" button injected by src/scripts/work.ts.
import { Picture } from 'astro:assets';
import { workSection, movePhysiq, fandom, plugins, kb, earlier, type SmallWork } from '../../data/work';
import ForPill from './ForPill.astro';
import Chip from './Chip.astro';
import Slot from './Slot.astro';
import Diagram from './Diagram.astro';

const small: SmallWork[] = [plugins, kb];
const smallDelay: Record<string, string> = { pl: '0', kb: '100' };
const pill = 'font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 1px solid #E4DACA; color: #4E4A44; background: #FBF6EE; white-space: nowrap;';
---
<section id="work" data-chapter="03" aria-labelledby="work-h">
  <div class="sec" data-pause style="max-width: 1180px; margin: 0 auto; padding: 0 var(--gutter) var(--section-pb); display: flex; flex-direction: column; gap: 12px;">
    <div data-reveal="" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 0 4px 20px;">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <span style="font-family: 'Geist Mono', monospace; font-size: 12px; color: #5C5850;">{workSection.num}</span>
        <h2 id="work-h" style="margin: 0; font-weight: 500; font-size: clamp(48px,6vw,88px); line-height: .92; letter-spacing: -.05em;">{workSection.heading}</h2>
      </div>
      <p style="margin: 0; max-width: 32ch; text-align: right; font-size: 16px; line-height: 1.45; font-weight: 500; color: #4E4A44;">{workSection.lead}</p>
    </div>

    <article class="wk-card wk-mp" data-reveal="" data-test="work-card" data-key={movePhysiq.key} style="display: flex; flex-wrap: wrap; background: #111111; color: #FBF6EE; border-radius: 16px; overflow: hidden;">
      <div class="wk-shot" style="flex: 1.25 1 480px; min-width: 0; position: relative; background: #222222;">
        <div style="position: absolute; inset: 14px; border-radius: 10px; overflow: hidden; background: #111111;">
          <Picture src={movePhysiq.shot} alt={movePhysiq.shotAlt} formats={['avif']} fallbackFormat="webp" widths={[480, 960]} sizes="(min-width: 1180px) 600px, 90vw" loading="lazy" style="display: block; width: 100%; height: 100%; object-fit: contain;" />
        </div>
      </div>
      <div style="flex: 1 1 360px; min-width: 0; padding: clamp(28px,3.4vw,40px); display: flex; flex-direction: column; gap: 18px;">
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          <span style="display: inline-flex; align-items: center; gap: 8px; font-size: 12px; padding: 6px 12px; border-radius: 999px; background: #FBF6EE; color: #111111; white-space: nowrap;"><span style="width: 6px; height: 6px; border-radius: 50%; background: #2F7A55; animation: azPulse 2.6s ease-in-out infinite;"></span>{movePhysiq.status}</span>
          <span class="wk-notph" style="font-size: 12px; padding: 6px 12px; border-radius: 999px; border: 1px solid #3A3A3A; color: #BDB6AA; white-space: nowrap;">{movePhysiq.category}</span>
          <ForPill label={movePhysiq.audience[0]} />
        </div>
        <h3 style="margin: 0; font-weight: 500; font-size: clamp(40px,4.4vw,60px); line-height: .95; letter-spacing: -.045em;">{movePhysiq.title}</h3>
        <p class="wk-short" style="margin: 0; font-size: 16px; line-height: 1.45; font-weight: 500; color: #FBF6EE;">{movePhysiq.short}</p>
        <div class="wk-body" id="wk-body-mp">
          <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #CFC8BC; text-wrap: pretty;">{movePhysiq.body}</p>
          <div style="display: flex; flex-direction: column;">
            {movePhysiq.features.map((f) => (
              <div style="display: flex; gap: 14px; align-items: baseline; padding: 10px 0; border-top: 1px solid #2E2E2E; font-size: 14px; line-height: 1.5; color: #FBF6EE;"><span style="font-family: 'Geist Mono', monospace; font-size: 12px; color: #77716A;">{f.n}</span><span>{f.t}</span></div>
            ))}
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto;">
            {movePhysiq.stack.map((t) => <Chip name={t.name} icon={t.icon} variant="mp" />)}
          </div>
        </div>
        <Slot variant="dark" />
      </div>
    </article>

    <div style="display: flex; flex-wrap: wrap; gap: 12px;">
      <article class="wk-card" data-reveal="" data-test="work-card" data-key={fandom.key} style="flex: 1 1 100%; min-width: 0; background: #F1EADF; border: 1.5px solid #111111; border-radius: 16px; padding: clamp(26px,3vw,36px); display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between;">
          <span style="display: flex; flex-wrap: wrap; gap: 6px;"><span class="wk-notph" style="font-size: 12px; padding: 6px 12px; border-radius: 999px; background: #FBF6EE; border: 1px solid #E4DACA; white-space: nowrap;">{fandom.category}</span><ForPill label={fandom.audience[0]} /></span>
          <span class="wk-notph" style="font-family: 'Geist Mono', monospace; font-size: 12px; color: #5C5850; padding: 6px 0;">{fandom.flowLabel}</span>
        </div>
        <h3 style="margin: 0; font-weight: 500; font-size: clamp(36px,4.4vw,60px); line-height: .98; letter-spacing: -.045em; max-width: 18ch;">{fandom.title}</h3>
        <p class="wk-short" style="margin: 0; font-size: 16px; line-height: 1.45; font-weight: 500; color: #111111;">{fandom.short}</p>
        <div class="wk-body" id="wk-body-fd">
          <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4E4A44; text-wrap: pretty;">{fandom.body}</p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            {fandom.metrics.map((m, i) => (
              <span style={i === 0 ? 'display: flex; flex-direction: column; gap: 2px; padding: 14px 18px; border-radius: 12px; background: #111111; color: #FBF6EE; min-width: 150px;' : 'display: flex; flex-direction: column; gap: 2px; padding: 14px 18px; border-radius: 12px; background: #FBF6EE; border: 1px solid #E4DACA; min-width: 150px;'}><span style="font-size: 28px; font-weight: 500; letter-spacing: -.04em; line-height: 1;">{m.value}</span><span style={`font-size: 12px; color: ${i === 0 ? '#BDB6AA' : '#5C5850'};`}>{m.label}</span></span>
            ))}
          </div>
          <Diagram />
          <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto;">
            {fandom.stack.map((t) => <Chip name={t.name} icon={t.icon} variant="fd" />)}
          </div>
        </div>
        <Slot variant="light" />
      </article>

      {small.map((w) => (
        <article class="wk-card" data-reveal="" data-delay={smallDelay[w.key]} data-test="work-card" data-key={w.key} style="flex: 1 1 420px; min-width: 0; background: #F1EADF; color: #111111; border: 1px solid #E4DACA; border-radius: 16px; padding: clamp(24px,3vw,32px); display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px;">
            <span style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
              <span style={pill}>{w.category}</span>
              {w.status && <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; padding: 5px 12px; border-radius: 999px; background: #FBF6EE; color: #111111; white-space: nowrap;"><span style="width: 6px; height: 6px; border-radius: 50%; background: #D97757; animation: azPulse 2.6s ease-in-out infinite;"></span>{w.status}</span>}
            </span>
            <span style="display: flex; flex-wrap: wrap; gap: 6px;">{w.audience.map((a) => <ForPill label={a} />)}</span>
          </div>
          <h4 style="margin: 0; font-size: clamp(24px,2.4vw,30px); font-weight: 500; line-height: 1.08; letter-spacing: -.035em;">{w.title}</h4>
          <p class="wk-short" style="margin: 0; font-size: 16px; line-height: 1.45; font-weight: 500; color: #111111;">{w.short}</p>
          <div class="wk-body" id={`wk-body-${w.key}`}>
            <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4E4A44; text-wrap: pretty;">{w.body} <strong style="color: #111111; font-weight: 600;">{w.bodyStrong}</strong></p>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 6px;">
              {w.tags.map((t) => <Chip name={t.name} icon={t.icon} variant="tag" />)}
            </div>
          </div>
          <Slot variant="light" />
        </article>
      ))}

      {earlier.map((e) => (
        <article class="wk-card" data-reveal="" data-delay={e.delay} data-test="work-card" data-key={e.key} style="flex: 1 1 260px; min-width: 0; background: #FBF6EE; border: 1px solid #E4DACA; border-radius: 16px; padding: 26px; display: flex; flex-direction: column; gap: 12px;">
          <span style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px;"><span style="font-family: 'Geist Mono', monospace; font-size: 12px; color: #5C5850;">{e.label}</span><ForPill label={e.audience[0]} /></span>
          <h4 style="margin: 0; font-size: 22px; font-weight: 500; line-height: 1.15; letter-spacing: -.025em;">{e.title}</h4>
          <p class="wk-short" style="margin: 0; font-size: 15px; line-height: 1.45; font-weight: 500; color: #111111;">{e.hook}</p>
          <div class="wk-body" id={`wk-body-${e.key}`}>
            <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #4E4A44; text-wrap: pretty;">{e.body}</p>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 8px;">
              {e.logos.map((t) => (
                <span style="display: inline-flex; align-items: center; gap: 7px; font-size: 13px; padding: 6px 12px 6px 6px; border-radius: 999px; background: #FFFFFF; border: 1px solid #E4DACA;"><span style="width: 22px; height: 22px; display: grid; place-items: center;"><img src={t.icon.src} width={t.icon.width} height={t.icon.height} alt="" loading="lazy" style="width: 18px; height: 18px; object-fit: contain;" /></span>{t.name}</span>
              ))}
            </div>
          </div>
          <Slot variant="light" />
        </article>
      ))}
    </div>
  </div>
</section>

<noscript><style>.wk-body { display: contents !important; } .wk-short { display: none !important; } .wk-shot { display: block !important; }</style></noscript>

<style is:global>
  .wk-body { display: contents; }
  .wk-short { display: none !important; }
  .wk-slot { display: none; }
  .wk-shot { min-height: 420px; order: 0; }
  @media (max-width: 859px) { .wk-shot { min-height: 300px; } }
  @media (max-width: 599px) {
    .wk-notph { display: none !important; }
    .wk-shot { min-height: 260px; order: 2; display: none; }
    .wk-card[data-open] .wk-shot { display: block; }
    .wk-card:not([data-open]) .wk-body { display: none; }
    .wk-short { display: block !important; }
    .wk-card[data-open] .wk-short { display: none !important; }
    .wk-slot { display: block; min-height: 44px; }
  }
  .wk-toggle { align-self: stretch; width: 100%; box-sizing: border-box; display: flex; justify-content: space-between; align-items: center; min-height: 44px; padding: 10px 14px; border-radius: 12px; border: 1px solid #CFC5B3; background: transparent; color: inherit; font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; }
  .wk-toggle[data-variant="dark"] { border-color: #3A3A3A; }
  .wk-toggle-i { font-family: 'Geist Mono', monospace; font-size: 16px; }
</style>

<script>
  import '../../scripts/work';
</script>
