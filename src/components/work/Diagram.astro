---
// Fandom data-flow diagram (v4:L394-492; logic v4:L995-1041). SSR = tick 0 (step 01, 00/24, v42);
// src/scripts/work.ts re-renders attributes/text from archTicker. Desktop (>= 600) and phone variants share one footer.
import { archPre, archAir, archOutputs, archMobileFinal, archCaptions, diagram, archCounter, archVersion, archNow, type ArchStep } from '../../data/work';

const badge = (a: ArchStep) => (a.badge === 'counter' ? archCounter(0) : a.badge === 'version' ? archVersion(0) : null);
const desktop: { a: ArchStep; i: number }[] = [...archPre, ...archAir].map((a, i) => ({ a, i }));
const mobile = [...archPre, ...archAir].map((a, i) => ({ num: a.num, label: a.label, sub: a.sub, icons: a.icons, badge: a.badge, i }));
mobile.push({ ...archMobileFinal, icons: [...archMobileFinal.icons], badge: undefined, i: 5 });
---
<figure class="wk-fig" data-arch data-st="0" aria-live="off">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px;">
    <span style="font-family: 'Geist Mono', monospace; font-size: 12px; color: #5C5850;">{diagram.title}</span>
    <span style="font-size: 12px; color: #5C5850;"><span class="wk-notph">{diagram.hint}</span><span class="wk-ph">{diagram.hintPhone}</span></span>
  </div>

  <div class="wk-mob" data-test="diagram-mobile">
    <span class="wk-pill wk-mpill" data-air-pill style="padding: 5px 12px 5px 6px;"><img src={diagram.airflowIcon.src} width={diagram.airflowIcon.width} height={diagram.airflowIcon.height} alt="" style="width: 16px; height: 16px; object-fit: contain;" />{diagram.airflowLabelIdle}</span>
    {mobile.map((m) => (
      <div class="wk-mcard" data-mcard={m.i} hidden={m.i !== 0}>
        <span style="position: absolute; left: 16px; top: 14px; font-family: 'Geist Mono', monospace; font-size: 12px; color: #BDB6AA;">{m.num}</span>
        {m.badge && <span data-badge={m.badge} style="position: absolute; right: 14px; top: 12px; font-family: 'Geist Mono', monospace; font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #7FC7A0; color: #111111;">{m.badge === 'counter' ? archCounter(0) : archVersion(0)}</span>}
        <span style="display: flex; gap: 10px; align-items: center; justify-content: center; height: 56px; padding: 0 12px; border-radius: 14px; background: #FFFFFF;">
          {m.icons.map((ic) => <img src={ic.src} width={ic.width} height={ic.height} alt="" loading="lazy" style="height: 38px; width: auto; max-width: 60px; object-fit: contain;" />)}
        </span>
        <span style="font-size: 22px; font-weight: 500; letter-spacing: -.02em; line-height: 1.15;">{m.label}</span>
        <span style="font-size: 13px; color: #BDB6AA;">{m.sub}</span>
      </div>
    ))}
  </div>

  <div class="wk-desk" data-test="diagram">
    <div class="wk-flow">
      {desktop.slice(0, 2).map(({ a, i }) => (
        <>
          <button type="button" class="wk-step" data-step={i} aria-label={`${diagram.stepLabelPrefix}${a.num}`} aria-current={i === 0 ? 'step' : undefined}>
            <span class="wk-n">{a.num}</span>
            <span class="wk-box">
              <span class="wk-ics">{a.icons.map((ic) => <img src={ic.src} width={ic.width} height={ic.height} alt="" loading="lazy" />)}</span>
              <span class="wk-lbl">{a.label}</span>
              <span class="wk-sub">{a.sub}</span>
            </span>
          </button>
          <div class="wk-conn" data-conn={i} aria-hidden="true"><span class="wk-arrow"></span><span class="wk-flowdot"></span></div>
        </>
      ))}
      <div class="wk-airbox">
        <span class="wk-pill wk-dpill" data-air-pill><img src={diagram.airflowIcon.src} width={diagram.airflowIcon.width} height={diagram.airflowIcon.height} alt="" style="width: 18px; height: 18px; object-fit: contain;" />{diagram.airflowLabel}</span>
        {desktop.slice(2).map(({ a, i }) => (
          <>
            <button type="button" class="wk-step" data-step={i} aria-label={`${diagram.stepLabelPrefix}${a.num}`}>
              <span class="wk-n">{a.num}</span>
              <span class="wk-box">
                {a.badge && <span class="wk-badge" data-badge={a.badge}>{badge(a)}</span>}
                <span class="wk-ics">{a.icons.map((ic) => <img src={ic.src} width={ic.width} height={ic.height} alt="" loading="lazy" />)}</span>
                <span class="wk-lbl">{a.label}</span>
                <span class="wk-sub">{a.sub}</span>
                {a.catalog && (
                  <span class="wk-cat">
                    <span class="wk-catline"></span>
                    <span class="wk-catbox">
                      <img src={diagram.catalog.icon.src} width={diagram.catalog.icon.width} height={diagram.catalog.icon.height} alt="" style="width: 22px; height: 22px;" />
                      <span style="display: flex; flex-direction: column; gap: 1px;"><span style="font-size: 12px; font-weight: 500; color: #111111;">{diagram.catalog.title}</span><span style="font-family: 'Geist Mono', monospace; font-size: 9px; color: #2F7A55;">{diagram.catalog.sub}</span></span>
                    </span>
                  </span>
                )}
              </span>
            </button>
            {a.hasNext && <div class="wk-conn" data-conn={i} aria-hidden="true"><span class="wk-arrow"></span><span class="wk-flowdot"></span></div>}
          </>
        ))}
      </div>
      <div class="wk-fork" aria-hidden="true">
        <span class="wk-fl" style="left: 0; top: 50%; width: 18px; height: 2px;"></span>
        <span class="wk-fl" style="left: 18px; top: 22%; bottom: 22%; width: 2px;"></span>
        <span class="wk-fl" style="left: 18px; top: 22%; width: 26px; height: 2px;"></span>
        <span class="wk-fl" style="left: 18px; bottom: 22%; width: 26px; height: 2px;"></span>
        <span class="wk-fdot" style="left: 0; top: calc(22% - 4px); animation: azDotUp 1.3s ease-in-out infinite;"></span>
        <span class="wk-fdot" style="left: 0; bottom: calc(22% - 4px); animation: azDotDown 1.3s ease-in-out infinite;"></span>
      </div>
      <button type="button" class="wk-step wk-out" data-step="5" aria-label={`${diagram.stepLabelPrefix}06`}>
        {archOutputs.map((o) => (
          <span class="wk-obox">
            <span style="display: flex; gap: 4px; align-items: center; flex: none;">{o.icons.map((ic) => <img src={ic.src} width={ic.width} height={ic.height} alt="" loading="lazy" style="height: 28px; width: auto; max-width: 44px; object-fit: contain;" />)}</span>
            <span style="display: flex; flex-direction: column; gap: 2px; min-width: 0;"><span class="wk-on" style="font-family: 'Geist Mono', monospace; font-size: 12px;">{o.num}</span><span class="wk-ol" style="font-size: 13px; font-weight: 500; line-height: 1.25;">{o.label}</span></span>
          </span>
        ))}
      </button>
    </div>
  </div>

  <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding-top: 16px; border-top: 1px solid #E4DACA;">
    <span style="display: flex; align-items: baseline; gap: 12px; min-width: 0; flex: 1 1 420px;"><span data-test="arch-now" style="font-family: 'Geist Mono', monospace; font-size: 12px; color: #2F7A55; white-space: nowrap;">{archNow(0)}</span><span data-test="arch-caption" style="font-size: clamp(16px,1.5vw,19px); font-weight: 500; letter-spacing: -.01em; line-height: 1.35;">{archCaptions[0]}</span></span>
    <span class="wk-dots" style="display: flex; gap: 6px;">
      {archCaptions.map((_, i) => <button type="button" class="wk-dot hit" data-test="arch-dot" data-dot={i} aria-label={`${diagram.dotLabelPrefix}${String(i + 1).padStart(2, '0')}`} aria-current={i === 0 ? 'step' : undefined}></button>)}
    </span>
    <span class="wk-pn">
      <button type="button" class="wk-prev" data-test="arch-prev">{diagram.prev}</button>
      <button type="button" class="wk-next" data-test="arch-next">{diagram.next}</button>
    </span>
  </div>
</figure>

<style is:global>
  .wk-fig { margin: 4px 0 0; background: #FBF6EE; border: 1px solid #E4DACA; border-radius: 14px; padding: clamp(18px,2.4vw,28px); display: flex; flex-direction: column; gap: 22px; }
  .wk-dot.hit::after { width: 100%; } /* dots sit 6px apart: widen the hit area vertically only */
  .wk-ph { display: none; }
  .wk-mob { display: none; }
  .wk-pn { display: none; }
  .wk-desk { overflow-x: auto; margin: 0 -6px; padding: 26px 6px 96px; }
  .wk-flow { min-width: 1040px; display: flex; align-items: center; }

  .wk-pill { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 500; padding: 5px 12px 5px 6px; border-radius: 999px; background: #FBF6EE; border: 1px solid #CFC5B3; color: #111111; white-space: nowrap; transition: background .5s ease, border-color .5s ease; }
  .wk-dpill { position: absolute; top: -15px; left: 16px; }
  .wk-airbox { flex: 3.4 1 0; min-width: 0; position: relative; display: flex; align-items: center; padding: 30px 14px 16px; border-radius: 20px; border: 1.5px solid #CFC5B3; background: transparent; transition: border-color .5s ease, background .5s ease; }
  .wk-fig:is([data-st="2"], [data-st="3"], [data-st="4"]) .wk-airbox { border-color: #7FC7A0; background: rgba(127,199,160,0.10); }
  .wk-fig:is([data-st="2"], [data-st="3"], [data-st="4"]) .wk-pill { background: #7FC7A0; border-color: #7FC7A0; }

  .wk-step { cursor: pointer; flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-align: left; transform-origin: center; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .wk-step[aria-current="step"] { transform: scale(1.08); }
  .wk-n { font-family: 'Geist Mono', monospace; font-size: 12px; color: #77716A; }
  .wk-step[aria-current="step"] .wk-n { color: #111111; }
  .wk-box { position: relative; background: #FFFFFF; border: 1.5px solid #E4DACA; border-radius: 14px; padding: 16px 14px; display: flex; flex-direction: column; align-items: center; gap: 12px; box-shadow: none; transition: background .5s ease, border-color .5s ease, box-shadow .5s ease; }
  .wk-step[aria-current="step"] .wk-box { background: #111111; border-color: #111111; box-shadow: 0 18px 36px -18px rgba(17,17,17,0.55); }
  .wk-badge { position: absolute; top: -11px; right: 10px; font-family: 'Geist Mono', monospace; font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #FFFFFF; border: 1px solid #E4DACA; color: #111111; }
  .wk-ics { display: flex; gap: 6px; align-items: center; justify-content: center; height: 40px; }
  .wk-ics img { height: 36px; width: auto; max-width: 56px; object-fit: contain; }
  .wk-lbl { font-size: 14px; font-weight: 500; text-align: center; line-height: 1.25; color: #111111; }
  .wk-sub { font-size: 11px; color: #5C5850; text-align: center; margin-top: -6px; }
  .wk-step[aria-current="step"] .wk-lbl { color: #FBF6EE; }
  .wk-step[aria-current="step"] .wk-sub { color: #BDB6AA; }
  .wk-cat { position: absolute; left: 50%; top: 100%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; }
  .wk-catline { display: block; width: 2px; height: 34px; background-image: repeating-linear-gradient(180deg, #2F7A55 0 5px, transparent 5px 10px); background-size: 2px 20px; animation: azDash .9s linear infinite; }
  .wk-catbox { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 12px; background: #FFFFFF; border: 1.5px dashed #2F7A55; white-space: nowrap; }

  /* connectors: no colour transition (state is asserted synchronously by tests) */
  .wk-conn { flex: 0 0 44px; position: relative; height: 2px; margin-top: 24px; background: #CFC5B3; }
  .wk-arrow { position: absolute; right: -2px; top: -4px; width: 0; height: 0; border-left: 7px solid #CFC5B3; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .wk-conn[data-on] { background: #2F7A55; }
  .wk-conn[data-on] .wk-arrow { border-left-color: #2F7A55; }
  .wk-flowdot { display: none; position: absolute; top: -4px; left: 0; width: 10px; height: 10px; border-radius: 50%; background: #2F7A55; animation: azDot 1.1s ease-in-out infinite; }
  .wk-conn[data-flow] .wk-flowdot { display: block; }

  .wk-fork { flex: 0 0 44px; position: relative; align-self: stretch; margin-top: 24px; }
  .wk-fl { position: absolute; background: #CFC5B3; }
  .wk-fdot { display: none; position: absolute; width: 10px; height: 10px; border-radius: 50%; background: #2F7A55; }
  .wk-fig[data-st="5"] .wk-fl { background: #2F7A55; }
  .wk-fig[data-st="5"] .wk-fdot { display: block; }
  .wk-out { flex: 1.1 1 0; gap: 14px; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .wk-out[aria-current="step"] { transform: scale(1.06); }
  .wk-obox { background: #FFFFFF; border: 1.5px solid #E4DACA; border-radius: 14px; padding: 12px 14px; display: flex; align-items: center; gap: 12px; transition: background .5s ease, border-color .5s ease; }
  .wk-on { color: #5C5850; }
  .wk-ol { color: #111111; }
  .wk-out[aria-current="step"] .wk-obox { background: #111111; border-color: #111111; box-shadow: 0 18px 36px -18px rgba(17,17,17,0.55); }
  .wk-out[aria-current="step"] .wk-on { color: #BDB6AA; }
  .wk-out[aria-current="step"] .wk-ol { color: #FBF6EE; }

  .wk-dot { width: 8px; height: 8px; border-radius: 999px; border: 0; padding: 0; cursor: pointer; background: #CFC5B3; transition: width .4s ease, background .4s ease; }
  .wk-dot[aria-current="step"] { width: 26px; background: #111111; }

  .wk-mcard { position: relative; width: 100%; box-sizing: border-box; min-height: 200px; background: #111111; color: #FBF6EE; border-radius: 16px; padding: 26px 20px 22px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; }
  .wk-mcard[hidden] { display: none; }

  .wk-prev, .wk-next { min-height: 48px; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 500; cursor: pointer; }
  .wk-prev { border: 1px solid #CFC5B3; background: transparent; color: #111111; }
  .wk-next { border: 0; background: #111111; color: #FBF6EE; }

  @media (max-width: 599px) {
    .wk-notph { display: none; }
    .wk-ph { display: inline; }
    .wk-desk { display: none; }
    .wk-mob { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 8px 0; }
    /* phone: real 24x24 boxes (axe target-size); the painted dot stays 8px via content-box clipping */
    .wk-dots { gap: 0 !important; }
    .wk-dot { box-sizing: content-box; padding: 8px; background-clip: content-box; }
    .wk-pn { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: 100%; }
  }
</style>
